{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Baghcheh",
  "version": "1.0.0",
  "identifier": "org.baghcheh.hub",
  "build": {
    "frontendDist": "../blank"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg", "app", "appimage", "deb"],
    "category": "Education",
    "shortDescription": "باغچه: آموزش رایگان برای کودکان فارسی‌زبان",
    "longDescription": "Baghcheh: free, offline learning for Persian-speaking children. This app keeps the family's progress in a file, makes a daily backup and lets tablets and other computers on the home Wi-Fi sync with it. Nothing leaves the home network.",
    "copyright": "Baghcheh contributors",
    "license": "AGPL-3.0-or-later",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": { "languages": ["Persian", "English"], "displayLanguageSelector": false }
    }
  }
}
